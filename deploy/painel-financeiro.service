# Serviço systemd do usuário para o Painel Financeiro.
# Instalação (sem sudo):
#   mkdir -p ~/.config/systemd/user
#   ln -sf "$PWD/deploy/painel-financeiro.service" ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now painel-financeiro
#   loginctl enable-linger "$USER"   # inicia no boot mesmo sem login
# Logs: journalctl --user -u painel-financeiro -f

[Unit]
Description=Painel Financeiro (controle de cartões e patrimônio)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projects/painel-financeiro
ExecStart=%h/.local/opt/node/bin/node --env-file-if-exists=.env src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
